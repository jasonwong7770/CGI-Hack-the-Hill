# Copy this file to .env and fill in your Supabase project values.
# Leave the values unset (or skip this file) to run in demo mode with sample accounts.
# Found in Supabase Dashboard -> Project Settings -> API.
# Only use the public "anon" key here. NEVER put the service_role key in a frontend app.
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key